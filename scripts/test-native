#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
kind=${1:-}
case "$kind" in
  input) fixture=Input; report=native-ime-tests ;;
  scroll) fixture=Scroll; report=scroll-native ;;
  selection) fixture=Selection; report=selection-native ;;
  tiling) fixture=Tiling; report=tiling-native ;;
  protocols) fixture=Protocols; report=protocols-native ;;
  ghostty) fixture=Ghostty; report=ghostty-production-native ;;
  notifications) fixture=Notifications; report=notifications-native ;;
  status) fixture=Status; report=status-native ;;
  osc) fixture=Osc; report=osc-native-acceptance ;;
  gitlive) fixture=GitLive; report=git-live-native ;;
  *) echo 'Usage: scripts/test-native {input|scroll|selection|tiling|protocols|ghostty|notifications|status|osc|gitlive} [NSH test options]' >&2; exit 2 ;;
esac
shift
# NSH resolves open() relative to the test module. Acceptance sources use
# root-relative fixture paths and stay outside default *.test.tsx discovery.
runner_base=$(mktemp "$project_dir/.native-$kind.XXXXXX")
runner="$runner_base.test.tsx"
trap 'rm -f "$runner" "$runner_base"' EXIT HUP INT TERM
cp "$project_dir/tests/native/$fixture.acceptance.tsx" "$runner"
if [ "$kind" = scroll ]; then set -- --fps "$@"; fi
"$project_dir/scripts/nsh" test "$runner" --target macos --junit "artifacts/$report.xml" "$@"
